# Credenciales del proyecto de Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor. Project Settings -> API -> "service_role". NUNCA con prefijo NEXT_PUBLIC_
# ni subirla a GitHub. La usa el panel de TalenTree para crear las cuentas de club.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la app (para armar los links de acceso de los clubes).
# Opcional: si no está, se usa el dominio desde el que entra el admin.
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
